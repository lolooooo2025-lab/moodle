# Taleb Talta — Neon Environment Variables
# Copy to .env.local and fill in your Neon credentials

# Database (Neon — use Direct/unpooled endpoint for asyncpg)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-XXXXX-XXXXX.region-X.aws.neon.tech/taleb_talta?sslmode=require
DATABASE_URL_UNPOOLED=postgresql+asyncpg://USER:PASSWORD@ep-XXXXX-XXXXX.region-X.aws.neon.tech/taleb_talta?sslmode=require

# App settings
TT_NETLIFY=1
TT_PUBLIC_ORIGIN=https://your-site.netlify.app
TT_INTERNAL_ORIGIN=https://your-site.netlify.app

# Security
TT_CRON_TOKEN=replace-with-32-hex-chars
TT_STREAM_SECRET=replace-with-32-hex-chars
TT_PEPPER_ENABLED=1

# Owner account
TT_OWNER_PHONE=01000000000
TT_OWNER_PASSWORD=replace-with-strong-password

# Web Push (optional — generate with: openssl ecparam -genkey -name prime256v1 -noout -out vapid-private.pem && openssl ec -in vapid-private.pem -pubout -out vapid-public.pem)
TT_VAPID_SUBJECT=mailto:support@taleb-talta.local
TT_VAPID_PRIVATE_KEY=replace-with-base64-private-key
TT_VAPID_PUBLIC_KEY=replace-with-base64-public-key

# Database pool (Neon free tier: 5 connections)
TT_DB_POOL_SIZE=5
TT_DB_MAX_OVERFLOW=2
