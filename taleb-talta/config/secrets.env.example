# Taleb Talta — private configuration TEMPLATE.
# Copy to config/secrets.env (chmod 600) or point TT_SECRETS_FILE at a private
# path outside the delivered source tree. NEVER commit the filled file.
# Process environment variables override this file.

# Canonical HTTPS origin (required for production CSRF/origin checks)
TT_PUBLIC_ORIGIN=https://example.com

# PostgreSQL (required for a real deployment)
TT_DATABASE_URL=postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Generated server secrets. Replace every placeholder before production.
# Example generator: python -c "import secrets; print(secrets.token_hex(32))"
TT_PASSWORD_PEPPER=REPLACE_WITH_64_HEX_CHARS
TT_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS
TT_CRON_TOKEN=REPLACE_WITH_64_HEX_CHARS
TT_STREAM_SECRET=REPLACE_WITH_64_HEX_CHARS
TT_VAPID_PRIVATE_KEY=REPLACE_WITH_64_HEX_CHARS

# First owner bootstrap. Existing accounts are NOT changed by these values.
TT_OWNER_PHONE=
TT_OWNER_PASSWORD=

# Public Web Push contact (not a secret, but deployment-specific)
TT_VAPID_SUBJECT=mailto:support@example.com

# Optional until the AI wave is enabled
TT_GEMINI_API_KEY=

# Production HTTPS defaults; local run_dev.sh overrides what it needs.
TT_COOKIE_SECURE=1
TT_COOKIE_PARTITIONED=1
TT_DEBUG=0
TT_ALLOW_FRAMING=0
