# Taleb Talta — free demo example (placeholders only, no real secrets).
# On Render you do NOT upload this file: set the variables in the dashboard.
# This file is only for local experiments with deploy/free-demo/start.py.

# Neon DIRECT connection string (not the pooled/-pooler endpoint).
TT_DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST/DB_NAME?sslmode=require

# First owner bootstrap. Use a strong temporary password, not the weak trial one.
TT_OWNER_PHONE=REPLACE_OWNER_PHONE
TT_OWNER_PASSWORD=REPLACE_STRONG_DEMO_PASSWORD
TT_VAPID_SUBJECT=mailto:REPLACE_CONTACT_EMAIL

# Render generates these automatically. For local use, generate 64-hex values.
TT_PASSWORD_PEPPER=REPLACE_64_HEX
TT_SESSION_SECRET=REPLACE_64_HEX
TT_CRON_TOKEN=REPLACE_64_HEX
TT_STREAM_SECRET=REPLACE_64_HEX
TT_VAPID_PRIVATE_KEY=REPLACE_64_HEX

# Free-demo defaults applied by deploy/free-demo/start.py.
TT_DEMO_MODE=1
TT_COOKIE_SECURE=1
TT_DEBUG=0
TT_ALLOW_FRAMING=0
TT_DB_POOL_SIZE=2
TT_DB_MAX_OVERFLOW=2
PORT=10000
